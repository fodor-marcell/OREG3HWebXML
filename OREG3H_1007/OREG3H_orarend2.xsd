<?xml version="1.0" encoding="UTF-8"?>

<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

    <xs:element name="OREG3H_orarend">
        <xs:complexType>
            <xs:sequence>

                <xs:element name="ora" maxOccurs="unbounded">
                    <xs:complexType>
                        <xs:sequence>

                            <xs:element name="targy" type="xs:string"/>

                            <xs:element name="idopont">
                                <xs:complexType>
                                    <xs:sequence>
                                        <xs:element name="nap">
                                            <xs:simpleType>
                                                <xs:restriction base="xs:string">
                                                    <xs:enumeration value="Hétfő"/>
                                                    <xs:enumeration value="Kedd"/>
                                                    <xs:enumeration value="Szerda"/>
                                                    <xs:enumeration value="Csütörtök"/>
                                                    <xs:enumeration value="Péntek"/>
                                                    <xs:enumeration value="Szombat"/>
                                                    <xs:enumeration value="Vasárnap"/>
                                                </xs:restriction>
                                            </xs:simpleType>
                                        </xs:element>

                                        <xs:element name="tol" type="xs:time"/>
                                        <xs:element name="ig" type="xs:time"/>

                                    </xs:sequence>
                                </xs:complexType>
                            </xs:element>

                            <xs:element name="helyszin" type="xs:string"/>
                            <xs:element name="oktato" type="xs:string"/>
                            <xs:element name="szak" type="xs:string"/>

                        </xs:sequence>

                        <xs:attribute name="id" type="xs:positiveInteger" use="required"/>

                        <xs:attribute name="tipus" use="required">
                            <xs:simpleType>
                                <xs:restriction base="xs:string">
                                    <xs:enumeration value="Elmélet"/>
                                    <xs:enumeration value="Gyakorlat"/>
                                </xs:restriction>
                            </xs:simpleType>
                        </xs:attribute>

                    </xs:complexType>
                </xs:element>

            </xs:sequence>
        </xs:complexType>
    </xs:element>

</xs:schema>